{
  "name": "playloop",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "client",
    "server",
    "shared",
    "lambdas/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @playloop/server",
    "dev:client": "npm run dev -w @playloop/client",
    "start": "npm start -w @playloop/server",
    "test": "npm test -w @playloop/server",
    "test:client": "npm test -w @playloop/client",
    "build:client": "npm run build -w @playloop/client",
    "lint:client": "npm run lint -w @playloop/client",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "spec:lint": "redocly lint playloop",
    "spec:bundle": "redocly bundle playloop",
    "services:up": "docker compose up -d --wait && docker compose wait storage-init",
    "services:down": "docker compose down"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@redocly/cli": "^2.64.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10"
  }
}
