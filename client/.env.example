# Base URL for API requests. Leave unset to use /api, which Vite proxies to http://localhost:4000.
VITE_API_BASE_URL=/api

# In development the auth endpoints (sign up, log in, username check, /me) are answered by MSW mocks
# from src/mocks. Set to "off" to send them to the real API instead.
# VITE_API_MOCKING=off
