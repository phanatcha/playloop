NODE_ENV=development
PORT=4000
LOG_LEVEL=info

MONGODB_URI=mongodb://localhost:27017/playloop?replicaSet=rs0

JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:5173

AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=playloop
AWS_SECRET_ACCESS_KEY=playloop-secret
S3_ENDPOINT=http://localhost:9000
S3_MEDIA_BUCKET=playloop-local-media
S3_BUILDS_BUCKET=playloop-local-builds
S3_PLAY_BUCKET=playloop-local-play
MEDIA_CDN_URL=http://localhost:9000/playloop-local-media
PLAY_CDN_URL=http://localhost:9000/playloop-local-play

INTERNAL_WEBHOOK_SECRET=change-me

PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=
